# Required
ANTHROPIC_API_KEY=

# Storage (relative to the directory you run `brag` from)
# WORKING_DIR=./rag_storage
# OUTPUT_DIR=./output

# Entity types written by `brag ontology propose` (used when the file exists)
# ONTOLOGY_FILE=./ontology.yaml

# Claude (LLM + vision)
# Platform: anthropic (default), bedrock, vertex or foundry. Each uses its usual credentials:
#   bedrock: AWS_REGION + AWS credentials;  vertex: CLOUD_ML_REGION, ANTHROPIC_VERTEX_PROJECT_ID + gcloud ADC
#   foundry: ANTHROPIC_FOUNDRY_RESOURCE + ANTHROPIC_FOUNDRY_API_KEY
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5            # bedrock default: anthropic.claude-opus-5-5; foundry: your deployment name
# LLM_FALLBACK_MODEL=                  # model to retry on if a request is declined
# LLM_EFFORT=medium
# LLM_MAX_TOKENS=16000
# LLM_MAX_ASYNC=4

# Local embeddings (changing this requires re-indexing)
# EMBEDDING_MODEL=BAAI/bge-m3

# Optional reranker (local cross-encoder, ~2.3 GB download for this one)
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Storage backends (LightRAG classes) and their connection settings
# KV_STORAGE=JsonKVStorage              # PGKVStorage, RedisKVStorage, MongoKVStorage
# VECTOR_STORAGE=NanoVectorDBStorage    # PGVectorStorage, QdrantVectorDBStorage, MilvusVectorDBStorage, ...
# GRAPH_STORAGE=NetworkXStorage         # Neo4JStorage, PGGraphStorage, MongoGraphStorage, ...
# DOC_STATUS_STORAGE=JsonDocStatusStorage  # PGDocStatusStorage, RedisDocStatusStorage, ...
# WORKSPACE=                            # separates several indexes in one set of backends
# POSTGRES_HOST=localhost  POSTGRES_PORT=5432  POSTGRES_USER=  POSTGRES_PASSWORD=  POSTGRES_DATABASE=
# NEO4J_URI=  NEO4J_USERNAME=  NEO4J_PASSWORD=
# QDRANT_URL=

# PDF: OCR for scanned pages (install an OCR engine Docling supports first)
# PDF_OCR=false

# Language the knowledge graph is written in
# KG_LANGUAGE=English

# Chunking
# CHUNK_TOKENIZER=o200k_base
# CHUNK_SIZE=1024
# TABLE_MODAL_MAX_ROWS=40
# MIN_IMAGE_PX=64

# HTTP service (`brag serve`, needs `pip install 'brag-rag[server]'`)
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=api://brag               # the audience (aud) your tokens are issued for
# OIDC_GROUPS_CLAIM=groups               # dotted paths work, e.g. realm_access.roles (Keycloak)
# OIDC_JWKS_URL=                         # only if the issuer has no discovery document
# BRAG_DATA_DIR=./brag_data              # uploaded files, one folder per index
# AUDIT_LOG=./brag_audit.jsonl
# AUDIT_LOG_QUESTIONS=true               # set false to keep question text out of the log
# MAX_UPLOAD_MB=100
