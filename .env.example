# Required
ANTHROPIC_API_KEY=

# Storage (relative to the directory you run `brag` from)
# WORKING_DIR=./rag_storage
# OUTPUT_DIR=./output

# Entity types written by `brag ontology propose` (used when the file exists)
# ONTOLOGY_FILE=./ontology.yaml

# Claude (LLM + vision)
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# LLM_MAX_TOKENS=16000
# LLM_MAX_ASYNC=4

# Local embeddings (changing this requires re-indexing)
# EMBEDDING_MODEL=BAAI/bge-m3

# Language the knowledge graph is written in
# KG_LANGUAGE=English

# Chunking
# CHUNK_TOKENIZER=o200k_base
# CHUNK_SIZE=1024
# TABLE_MODAL_MAX_ROWS=40
# MIN_IMAGE_PX=64
